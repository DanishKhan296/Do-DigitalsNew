generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String   @default("Administrator")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ CONTENT BLOBS (JSON key/value store) ============
// keys: home | about | footer | seo | settings | contact_page | privacy | terms

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============ SERVICES ============

model Service {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  tagline          String       @default("")
  shortDescription String       @default("")
  description      String       @default("")
  icon             String       @default("Palette")
  image            String       @default("")
  heroImage        String       @default("")
  features         String       @default("[]")
  whatsappMessage  String       @default("")
  order            Int          @default(0)
  published        Boolean      @default(true)
  faqs             ServiceFaq[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ServiceFaq {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int     @default(0)
}

// ============ PORTFOLIO ============

model PortfolioCategory {
  id       String             @id @default(cuid())
  name     String             @unique
  slug     String             @unique
  order    Int                @default(0)
  projects PortfolioProject[]
}

model PortfolioProject {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  shortDescription String            @default("")
  description      String            @default("")
  categoryId       String?
  category         PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  thumbnail        String            @default("")
  images           String            @default("[]")
  technologies     String            @default("[]")
  client           String            @default("")
  completionDate   String            @default("")
  featured         Boolean           @default(false)
  published        Boolean           @default(true)
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ============ TESTIMONIALS & STATS ============

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  designation String   @default("")
  company     String   @default("")
  content     String
  rating      Int      @default(5)
  image       String   @default("")
  published   Boolean  @default(true)
  isDemo      Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Statistic {
  id      String  @id @default(cuid())
  label   String
  value   Int     @default(0)
  suffix  String  @default("+")
  order   Int     @default(0)
  visible Boolean @default(true)
}

// ============ CONTACT INQUIRIES ============

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  service   String   @default("")
  budget    String   @default("")
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

// ============ BLOG ============

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @default("")
  content        String        @default("")
  featuredImage  String        @default("")
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           String        @default("[]")
  status         String        @default("DRAFT")
  seoTitle       String        @default("")
  seoDescription String        @default("")
  isDemo         Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ============ MEDIA LIBRARY ============

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  url         String
  mimeType    String   @default("")
  size        Int      @default(0)
  alt         String   @default("")
  description String   @default("")
  data        Bytes?
  createdAt   DateTime @default(now())
}

// ============ NAVIGATION / SOCIAL ============

model NavigationItem {
  id      String  @id @default(cuid())
  label   String
  href    String
  order   Int     @default(0)
  visible Boolean @default(true)
}

model SocialLink {
  id       String  @id @default(cuid())
  platform String
  url      String  @default("")
  icon     String  @default("Globe")
  visible  Boolean @default(true)
  order    Int     @default(0)
}

// ============ ACTIVITY LOG ============

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  details   String   @default("")
  createdAt DateTime @default(now())
}
